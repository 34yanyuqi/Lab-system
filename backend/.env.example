# 服务器配置
PORT=3000
NODE_ENV=development

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# 数据库配置
DB_PATH=./stutaskcheck.db

# CORS 配置
CORS_ORIGIN=*

# 上传配置
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# SMTP 邮箱配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@example.com

# 激活链接前缀
ACTIVATION_LINK_PREFIX=http://localhost:3000/

# 前端静态文件路径
# 开发环境: ../frontend/dist
# 生产环境: /www/wwwroot/frontend
FRONTEND_PATH=../frontend/dist

# ===== AI / LangChain 配置 =====
# API 密钥（兼容 OpenAI 及第三方代理）
AI_API_KEY=sk-xxx
# API 基础地址（默认为 OpenAI 官方，使用代理时修改此项）
AI_API_BASE=https://api.openai.com/v1
# 模型名称（推荐 gpt-4o-mini，性价比高）
AI_MODEL=gpt-4o-mini
# 温度参数（0-1，越高越随机）
AI_TEMPERATURE=0.7
# 最大输出 token 数
AI_MAX_TOKENS=4096

# ===== AI 多模态识图（PDF 直接送图，不再提取文字） =====
# 视觉模型名称。留空则自动复用 AI_MODEL（很多主模型本身就支持图片，
# 例如 deepseek-v4-flash 实测可直接识图），换服务商时无需改动这里。
AI_VISION_MODEL=deepseek-v4-flash-vision-exp
# PDF 处理模式：vision（默认，渲染为页面图片交给视觉模型）| text（旧的纯文本提取）
AI_PDF_MODE=vision
# 单个 PDF 最多渲染的页数
AI_VISION_MAX_PAGES=15
# 单次请求最多携带的图片总数（多周分析时按周平均分配）
AI_VISION_MAX_IMAGES=30
# 渲染长边像素（模型端会缩放到约 800x800 等效像素，故无需过大）
AI_VISION_MAX_EDGE=1600
# 渲染 JPEG 质量（40-100）
AI_VISION_JPEG_QUALITY=85
# 图片细节级别：low | high | original | auto
AI_VISION_DETAIL=high
# 并发渲染数
AI_VISION_CONCURRENCY=2
# 是否启用渲染缓存（按 文件路径+mtime+渲染参数 缓存，避免每轮对话重复渲染）
AI_VISION_CACHE=true
# 内存渲染缓存上限（MB）
AI_VISION_MAX_CACHE_MB=256
# 磁盘渲染缓存上限（MB，超出后淘汰最旧的条目）
AI_VISION_MAX_DISK_CACHE_MB=1024

# ===== AI 提示词自定义（可选） =====
# 单提交对话系统提示词（不设置则使用内置默认值）
# AI_SYSTEM_PROMPT=你是一个专业的教育审核助手...
# 多周进度分析提示词（不设置则使用内置默认值）
# AI_ANALYSIS_PROMPT=你是一个专业的教育评估专家...
